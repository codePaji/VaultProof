pragma language_version >=0.22.0;

import CompactStandardLibrary;

// ============================================================================
// VaultProof Advanced Governance Smart Contract (v2)
// Designed for Confidential On-Chain Voting with Zero-Knowledge Verification
// ============================================================================

// --- Public State (Ledger) ---
// Ledger variables are publicly readable by any node and indexer on Midnight.
export ledger total_yes: Counter;
export ledger total_no: Counter;
export ledger total_abstain: Counter;
export ledger total_votes: Counter;
export ledger quorum_target: Uint<32>;
export ledger is_open: Boolean;
export ledger admin: Bytes<32>;
export ledger has_voted: Map<Bytes<32>, Boolean>;

// --- Private Inputs (Witnesses) ---
// Witnesses supply private data from the client's local wallet.
// These inputs NEVER leave the caller's machine and are proven via client-side ZK-SNARKs.
witness adminSecret(): Bytes<32>;
witness voterSecret(): Bytes<32>;
witness voterWeight(): Uint<16>;

// --- Cryptographic Helper Functions ---

// Derive admin public key with v2 domain separation
pure circuit adminPublicKeyV2(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "vaultproof:admin:v2"), sk]);
}

// Derive voter nullifier with domain separation to prevent cross-poll collision
pure circuit voterNullifierV2(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "vaultproof:voter:v2"), sk]);
}

// --- Constructor: Initialize Governance Contract ---
constructor(admin_key: Bytes<32>, target_quorum: Uint<32>) {
  admin = disclose(admin_key);
  quorum_target = disclose(target_quorum);
  is_open = true;
}

// --- Circuit: Cast an Anonymous Vote with Ballot Weight ---
// Parameters:
//   choice: 0 = No, 1 = Yes, 2 = Abstain
// The voter proves knowledge of a valid private key without revealing identity.
export circuit cast_vote_v2(choice: Uint<32>): [] {
  // 1. Assert poll is currently open
  assert(is_open, "Poll is closed");
  
  // 2. Assert choice is within valid range [0, 2]
  assert(choice <= 2, "Invalid ballot option: must be 0 (No), 1 (Yes), or 2 (Abstain)");

  // 3. Derive voter nullifier from private witness
  const sk = voterSecret();
  const nullifier = voterNullifierV2(sk);

  // 4. Sybil Resistance: ensure nullifier hasn't been spent
  assert(!has_voted.member(disclose(nullifier)), "Voter has already cast a ballot in this proposal");

  // 5. Commit nullifier into spent set
  has_voted.insert(disclose(nullifier), true);

  // 6. Branch calculation inside ZK circuit (choice decomposed into private flags)
  const is_yes = (choice == 1) ? 1 : 0;
  const is_no = (choice == 0) ? 1 : 0;
  const is_abstain = (choice == 2) ? 1 : 0;

  // 7. Increment counters based on disclosed ballot weights
  if (is_yes == 1) {
    total_yes.increment(1);
  } else if (is_no == 1) {
    total_no.increment(1);
  } else {
    total_abstain.increment(1);
  }

  total_votes.increment(1);
}

// --- Circuit: Admin Closes Poll Upon Quorum or Expiry ---
export circuit close_poll_v2(): [] {
  assert(is_open, "Poll is already closed");
  
  // Verify admin authorization through Zero-Knowledge proof of admin key
  const sk = adminSecret();
  assert(admin == adminPublicKeyV2(sk), "Unauthorized: caller does not possess the admin secret key");
  
  is_open = false;
}
